{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "appearance": "system"
  },
  "shortcuts": {
    "bindings": {
      "focusLeft": {
        "first": {
          "command": true,
          "control": false,
          "key": "h",
          "keyCode": 4,
          "option": false,
          "shift": true
        }
      },
      "focusRight": {
        "first": {
          "command": true,
          "control": false,
          "key": "l",
          "keyCode": 37,
          "option": false,
          "shift": true
        }
      },
      "openBrowser": {
        "first": {
          "command": false,
          "control": false,
          "key": "",
          "option": false,
          "shift": false
        }
      },
      "triggerFlash": {
        "first": {
          "command": false,
          "control": false,
          "key": "",
          "option": false,
          "shift": false
        }
      }
    }
  },
  // "automation" mode admits local automation clients — including the launchd
  // autocompact daemon, which is NOT a cmux descendant — with no password, so
  // this file stays secret-free and shareable via git. The default "cmuxOnly"
  // rejects non-descendants (breaks the daemon); "password" mode would put a
  // secret in this committed, public file.
  "automation": {
    "socketControlMode": "automation"
  }
}