# ~/.zshenv -- sourced by EVERY zsh invocation: interactive, non-interactive
# (`zsh -c '...'`), and scripts. (.zshrc, by contrast, is interactive-only.)
# Keep this file minimal and side-effect-free.

# Disable zsh's built-in `log` so the command name resolves to macOS's
# /usr/bin/log -- the unified-logging CLI (`log show`, `log stream`).
#
# Background: zsh ships an obscure built-in `log` (prints users from the
# `watch` parameter). Because builtins outrank $PATH executables, a bare
# `log show ...` hits the builtin and dies with "too many arguments" in any
# non-interactive shell -- e.g. tools that run commands via `zsh -c`, like
# Claude Code's Bash tool. Disabling it here fixes that everywhere.
(( ${+builtins[log]} )) && disable log

# Cursor agent shells inherit SUDO_ASKPASS=…/cursor-askpass (TUI prompt). Agents are
# non-interactive so .zshrc never runs; force the local askpass helper instead.
# Re-bind at invoke time in case the agent wrapper resets the env after zshenv.
if [[ -n ${CURSOR_AGENT:-} || ${SUDO_ASKPASS:-} == *cursor-askpass* ]]; then
  export SUDO_ASKPASS="${HOME}/src/personal/dotfiles/bin/sudo_askpass.sh"
  sudo() {
    SUDO_ASKPASS="${HOME}/src/personal/dotfiles/bin/sudo_askpass.sh" command sudo -A "$@"
  }

  # Match $PWD Node via fnm (.nvmrc / .node-version / engines) for JS toolchain commands.
  _fnm_bin="${HOMEBREW_PREFIX:-/opt/homebrew}/bin/fnm"
  [[ -x $_fnm_bin ]] || _fnm_bin="$(command -v fnm 2>/dev/null)"
  if [[ -n $_fnm_bin ]]; then
    _fnm_ensure() {
      "$_fnm_bin" use --silent-if-unchanged >/dev/null 2>&1 && return
      "$_fnm_bin" install --log-level=quiet >/dev/null 2>&1 || true
      "$_fnm_bin" use --silent-if-unchanged >/dev/null 2>&1 || true
    }
    node() { _fnm_ensure; command node "$@"; }
    npm() { _fnm_ensure; command npm "$@"; }
    npx() { _fnm_ensure; command npx "$@"; }
    pnpm() { _fnm_ensure; command pnpm "$@"; }
    yarn() { _fnm_ensure; command yarn "$@"; }
  fi
fi
