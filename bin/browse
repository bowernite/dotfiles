#!/usr/bin/env bash
# browse — agent-browser against one shared, always-on, headed Chrome for Testing.
# Every conversation gets its own pinned tab; cookies live in one persistent profile.
#
#   browse <any agent-browser command/args>   # drop-in for `agent-browser`
#   browse focus                              # bring this conversation's tab + window forward
#   browse up                                 # just make sure the shared Chrome is running
#   browse doctor [--kill-strays]             # list (and kill) Chrome for Testing processes that aren't the shared one
#
# Env: BROWSE_NAME (extra tab per conversation, e.g. for parallel subagents), BROWSE_PORT, BROWSE_PROFILE
set -euo pipefail

PORT="${BROWSE_PORT:-9222}"
PROFILE="${BROWSE_PROFILE:-$HOME/.agent-browser/profiles/shared}"
APP="/Applications/Google Chrome for Testing.app"
STATE_DIR="$HOME/.agent-browser"
SHELLS='^-?(zsh|bash|sh|fish|login)$'
COMMANDS=' open read click dblclick type fill press keyboard hover focus check uncheck select drag upload download scroll scrollintoview wait screenshot pdf snapshot eval connect close back forward reload get is find mouse set network cookies storage tab diff trace profiler record console errors highlight inspect clipboard stream webmcp react vitals a11y pushstate removeinitscript batch auth plugin confirm deny session mcp chat dashboard install upgrade doctor profiles state skills '

main() {
  case "${1:-}" in
    up) ensure_chrome ;;
    focus) ensure_chrome; focus_tab ;;
    doctor) shift; doctor "$@" ;;
    *)
      ensure_chrome
      strip_owned_flags "$@"
      SESSION=$(session_id)
      TARGET_FILE="$STATE_DIR/$SESSION.target"
      [[ -e $TARGET_FILE ]] || prebind_tab
      if [[ "${ARGS[0]:-}" == close && "${ARGS[1]:-}" != --all ]]; then close_tab; fi
      run_with_tab_recovery "${ARGS[@]}"
      ;;
  esac
}

ensure_chrome() {
  if chrome_up; then
    pgrep -qf -- "--remote-debugging-port=$PORT --user-data-dir=$PROFILE" ||
      echo "browse: port $PORT is held by a Chrome that isn't the shared one — see 'browse doctor'" >&2
    return
  fi
  mkdir -p "$PROFILE"
  open -n -g -a "$APP" --args \
    --remote-debugging-port="$PORT" --user-data-dir="$PROFILE" \
    --no-first-run --no-default-browser-check --disable-hang-monitor \
    --password-store=basic --use-mock-keychain --disable-gpu \
    --disable-background-timer-throttling --disable-renderer-backgrounding \
    --disable-backgrounding-occluded-windows \
    --window-position=100,100 --window-size=1280,800
  for _ in $(seq 1 60); do
    chrome_up && return
    sleep 0.25
  done
  echo "browse: Chrome did not come up on port $PORT" >&2
  exit 1
}

chrome_up() {
  curl -sf "http://127.0.0.1:$PORT/json/version" >/dev/null
}

# One tab per conversation. Claude Code exposes a per-conversation id (inherited by subagents);
# elsewhere fall back to the nearest non-shell ancestor process + worktree, so a harness that keeps
# one shell per conversation still gets one tab per conversation
session_id() {
  local owner="${CLAUDE_CODE_SESSION_ID:-$(ancestor_pid):$(worktree_root)}"
  printf 'browse-%s' "$(printf '%s' "$owner${BROWSE_NAME:+:$BROWSE_NAME}" | shasum | cut -c1-12)"
}

ancestor_pid() {
  local pid=$PPID name
  while [[ $pid -gt 1 ]]; do
    name=$(ps -o comm= -p "$pid" 2>/dev/null | xargs basename 2>/dev/null || true)
    [[ $name =~ $SHELLS ]] || break
    pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  done
  echo "$pid"
}

worktree_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

# Session/browser selection is owned here; passing them through would fork agents off the shared Chrome
strip_owned_flags() {
  ARGS=()
  while (($#)); do
    case "$1" in
      --session=* | --cdp=* | --profile=* | --restore=*) warn_stripped "$1"; shift ;;
      --session | --cdp | --profile) warn_stripped "$1 $2"; shift 2 ;;
      --headed | --pin-tab | --no-pin-tab) warn_stripped "$1"; shift ;;
      --restore)
        if [[ $# -gt 1 && $2 != -* && $COMMANDS != *" $2 "* ]]; then warn_stripped "$1 $2"; shift 2; else warn_stripped "$1"; shift; fi
        ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
}

warn_stripped() {
  echo "browse: ignoring '$1' — browse owns session/browser selection (one shared Chrome, one tab per conversation)" >&2
}

# The daemon activates whatever tab it binds, which also brings the app forward once the user has ever
# focused it. Creating the tab in the background ourselves and handing the daemon the binding avoids that
prebind_tab() {
  command -v node >/dev/null || return 0
  local target
  target=$(node -e '
    const ws = new WebSocket(process.argv[1]);
    ws.onopen = () => ws.send(JSON.stringify({ id: 1, method: "Target.createTarget", params: { url: "about:blank", background: true } }));
    ws.onmessage = (e) => { const m = JSON.parse(e.data); if (m.id === 1) { console.log(m.result.targetId); ws.close(); } };
  ' "$(browser_ws_url)" 2>/dev/null) || return 0
  [[ -n $target ]] && printf '{"targetId":"%s","url":"about:blank","pinned":true}' "$target" > "$TARGET_FILE"
}

browser_ws_url() {
  curl -sf "http://127.0.0.1:$PORT/json/version" | python3 -c 'import json,sys; print(json.load(sys.stdin)["webSocketDebuggerUrl"])'
}

run_with_tab_recovery() {
  local stderr_file rc=0
  stderr_file=$(mktemp)
  ab "$@" 2>"$stderr_file" || rc=$?
  if ((rc)) && grep -q tab_gone "$stderr_file"; then
    ab close >/dev/null 2>&1 || true
    rm -f "$TARGET_FILE"
    prebind_tab
    rm -f "$stderr_file"
    exec agent-browser --cdp "$PORT" --session "$SESSION" --pin-tab "$@"
  fi
  cat "$stderr_file" >&2
  rm -f "$stderr_file"
  exit $rc
}

ab() {
  agent-browser --cdp "$PORT" --session "$SESSION" --pin-tab "$@"
}

close_tab() {
  ab tab close >/dev/null 2>&1 || true
  rm -f "$TARGET_FILE"
}

focus_tab() {
  local target_file="$STATE_DIR/$(session_id).target"
  [[ -e $target_file ]] && curl -sf "http://127.0.0.1:$PORT/json/activate/$(bound_target "$target_file")" >/dev/null
  osascript -e 'tell application "Google Chrome for Testing" to activate'
}

bound_target() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["targetId"])' "$1"
}

doctor() {
  local kill=0
  [[ "${1:-}" == --kill-strays ]] && kill=1
  local shared_pid strays=()
  shared_pid=$(pgrep -f -- "--remote-debugging-port=$PORT --user-data-dir=$PROFILE" | head -1 || true)
  echo "shared chrome: ${shared_pid:-not running} (port $PORT, profile $PROFILE)"
  while IFS= read -r line; do
    local pid=${line%% *}
    [[ -z $pid || $pid == "$shared_pid" ]] && continue
    strays+=("$pid")
    echo "stray: $line" | cut -c1-200
  done < <(pgrep -fl 'Google Chrome for Testing$|Google Chrome for Testing --' | grep -v crashpad || true)
  ((${#strays[@]})) || { echo "no strays"; return; }
  if ((kill)); then
    kill "${strays[@]}" 2>/dev/null || true
    echo "killed ${#strays[@]} stray(s)"
  else
    echo "run 'browse doctor --kill-strays' to kill them"
  fi
}

main "$@"
